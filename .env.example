# =============================================================================
# Divar Deal Hunter — configuration template
# Copy to `.env` and fill in your values:   cp .env.example .env
# `.env` is git-ignored. Every value below shows its built-in default.
# =============================================================================

# ---------------------------------------------------------------------------
# 1) Telegram alerting (REQUIRED unless DRY_RUN=true)
# ---------------------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Private chat id (numeric, e.g. 123456789) or channel handle (@my_deals) /
# channel id (-1001234567895). Get your own id from @userinfobot.
TELEGRAM_CHAT_ID=
# Optional proxy for Telegram only. HTTP(S) and SOCKS5 are both supported:
#   TELEGRAM_PROXY=http://127.0.0.1:8080
#   TELEGRAM_PROXY=socks5h://127.0.0.1:10808      (h = resolve DNS through proxy)
# SOCKS5 needs `pip install PySocks`.
TELEGRAM_PROXY=
# Rarely needs changing; useful for a self-hosted Bot API server.
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT=15
TELEGRAM_MAX_RETRIES=4
# Seconds to wait between two alerts (Telegram global limit is ~30 msg/s,
# per-chat limit is ~1 msg/s).
ALERT_SPACING_SECONDS=1.5
# Safety cap: if a cycle yields more deals than this, send the top N and a
# summary line for the rest instead of flooding the chat.
MAX_ALERTS_PER_CYCLE=20
# How many times a failed alert is retried on later cycles before being dropped.
MAX_ALERT_ATTEMPTS=3

# ---------------------------------------------------------------------------
# 2) What to hunt on Divar
# ---------------------------------------------------------------------------
# City: numeric Divar id ("1" = Tehran), an ASCII slug ("tehran"), or the
# Persian name ("تهران"). See divar_client.CITY_IDS for the built-in map.
CITY=tehran
# Optional explicit override of the numeric id resolved from CITY.
CITY_ID=
# Category slug from a Divar category URL. Electronics examples:
#   mobile-phones | tablet | mobile-tablet | electronic-devices | audio-video
#   laptop | computer-and-it | game-consoles-and-video-games | tv-projector
# Leave empty to watch every category in the city.
CATEGORY=mobile-phones
# Free-text search query (Persian works best, e.g. "آیفون ۱۳" or "s24 ultra").
SEARCH_QUERY=
# Comma separated Divar district ids to narrow the search (optional).
DISTRICT_IDS=
# Server-side price window in TOMAN. Applied by Divar before results return,
# so it also cuts bandwidth. Leave empty for no server-side bound.
PRICE_MIN=
PRICE_MAX=
# Only ads with at least one photo / only private (non-dealer) sellers.
HAS_PHOTO_ONLY=false
ONLY_PERSONAL_ADS=false
# How many cursor pages to walk per cycle (24–60 rows each).
PAGES_PER_CYCLE=1
PAGE_SIZE=24
# Hard cap on rows considered per cycle.
MAX_POSTS_PER_CYCLE=60
# Fetch each new post's detail page (description, exact price, category).
# Much better deal detection, but one extra request per new post.
FETCH_DETAILS=false
# Cap on detail-page lookups per cycle (only the best candidates get enriched).
MAX_DETAIL_LOOKUPS=10
# Drop posts older than this (minutes) so a restart after downtime does not
# replay stale listings. 0 disables the age check.
MAX_AGE_MINUTES=180

# ---------------------------------------------------------------------------
# 3) Deal detection rules
# ---------------------------------------------------------------------------
# The core threshold: alert on anything priced AT OR BELOW this many Toman.
DEAL_MAX_PRICE=50000000
# Ignore absurdly cheap listings (scams, "deposit only", accessories).
DEAL_PRICE_FLOOR=5000000
# Reject posts whose price is missing / negotiable / exchange-only.
REQUIRE_PRICE=true
# Skip listings where the displayed price is a down payment (پیش‌پرداخت)
# or an installment plan (اقساطی) rather than the total price.
SKIP_DOWN_PAYMENT_ADS=true
# Comma separated. If INCLUDE_KEYWORDS is non-empty, the title+description must
# contain at least one of them (matched case-insensitively, Persian digits
# normalized). EXCLUDE_KEYWORDS rejects on any hit.
INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=خراب,اوراق,قطعات,شکسته,پاره,معیوب,اجاره,رهن

# ---------------------------------------------------------------------------
# 4) Politeness, retries and network
# ---------------------------------------------------------------------------
# Seconds between full monitoring cycles.
CHECK_INTERVAL_SECONDS=60
# Jittered delay between individual HTTP requests to Divar (seconds).
REQUEST_DELAY_MIN=4
REQUEST_DELAY_MAX=9
REQUEST_TIMEOUT=20
MAX_RETRIES=5
# Exponential backoff for 429/503/timeouts: base * 2**attempt, capped.
BACKOFF_BASE=1.5
BACKOFF_MAX=60
# Optional proxy for Divar traffic. Divar's listing API usually only answers
# from inside Iran, so a local/VPN proxy is often required:
#   DIVAR_PROXY=socks5h://127.0.0.1:10808
DIVAR_PROXY=
# Fallback proxy used for BOTH Divar and Telegram when the specific one is unset.
PROXY_URL=
DIVAR_API_BASE=https://api.divar.ir
DIVAR_WEB_BASE=https://divar.ir
# auto   -> modern endpoint first, fall back to the legacy one on 4xx
# modern -> POST /v8/postlist/w/search
# legacy -> POST /v8/search/{city_id}/{category}
DIVAR_ENDPOINT_MODE=auto

# ---------------------------------------------------------------------------
# 5) State, logging and runtime behaviour
# ---------------------------------------------------------------------------
# SQLite file holding seen tokens (prevents duplicate alerts).
DB_PATH=data/seen_tokens.db
# Delete tokens older than this many days on every startup.
PRUNE_DAYS=14
# On the very first run, mark everything currently listed as seen WITHOUT
# alerting — otherwise you get 24 messages at once.
BOOTSTRAP_SILENT=true
LOG_LEVEL=INFO
# Optional log file (rotated). Leave empty to log to stdout only.
LOG_FILE=logs/divar-hunter.log
# Log alerts instead of sending them. Great for testing without a bot token.
DRY_RUN=false
# Timezone offset used for "زمان انتشار" in alerts (Tehran = 3.5).
TZ_OFFSET_HOURS=3.5
